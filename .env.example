# Canonical production origin, no trailing slash. REQUIRED in production:
# canonical URLs, sitemap, Open Graph and JSON-LD are all built from it.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager container (GTM-XXXXXXX). If set, configure GA4 inside GTM
# and leave NEXT_PUBLIC_GA_ID empty to avoid double-counting.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX), used only when GTM is not set.
NEXT_PUBLIC_GA_ID=

# Enquiry form endpoint. Receives a JSON POST (see src/lib/enquiry.ts).
# Works with Formspree, Basin, a serverless function or your CRM webhook.
# When empty, the form shows the email/phone fallback instead of submitting.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
